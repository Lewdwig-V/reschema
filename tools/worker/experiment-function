#!/usr/bin/env python3
"""experiment-function [--params FILE] CASE... -- call the task's ORIGINAL
function once per CASE (function tasks only).

FILE is your params.json (default /work/workspace/params.json); each CASE is a
JSON object with one value per param name (cstring values as hex, NUL
included). The host shows {ret, mem} for each call in the next observation's
`host_results`, in order. Each call costs one probe; an identical repeat is
free. Up to 32 cases per call, one turn.
"""

import json
import sys

args = sys.argv[1:]
path = "/work/workspace/params.json"
if args[:1] == ["--params"] and len(args) > 1:
    path, args = args[1], args[2:]
try:
    with open(path) as f:
        params = json.load(f)
except (OSError, ValueError, RecursionError) as e:
    sys.exit(f"experiment-function: cannot read params from {path}: {e}")
items = []
for arg in args:
    try:
        case = json.loads(arg)
    except (ValueError, RecursionError):
        case = None
    if type(case) is not dict:
        sys.exit(f"experiment-function: each case is a JSON object, not {arg[:80]!r}")
    arguments = {"params": params, "case": case}
    items.append({"operation": "experiment_function", "arguments": arguments})
if not 1 <= len(items) <= 32:
    sys.exit(__doc__)
print("WARRANTED_REQUEST")
print(json.dumps({"requests": items}))
